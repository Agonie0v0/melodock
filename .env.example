# MELODOCK_* is preferred. Legacy MUSICDL_* values remain supported.
MELODOCK_USER=admin
MELODOCK_PASS=请替换为至少16位的随机密码
MELODOCK_BIND=127.0.0.1
MELODOCK_PORT=8765
MELODOCK_COOKIE_SECURE=0
# Optional: disable Kugou public audio CDN certificate compatibility retry.
MELODOCK_PREVIEW_STRICT_TLS=0

# Search performance (restart the service after changing these).
MELODOCK_SEARCH_WORKERS=4
MELODOCK_SEARCH_WORKER_IDLE=20
MELODOCK_SEARCH_BUDGET=120
MELODOCK_SEARCH_QUEUE_TIMEOUT=30
MELODOCK_SEARCH_CACHE_TTL=30
MELODOCK_SONG_CACHE_MB=32
# Show resolved format and size in search results by default.
# Optional: set to 1 for QQ / Netease candidates resolved on playback/download.
# A saved choice in Settings > Engine behavior takes precedence.
MELODOCK_LAZY_SEARCH=0

# Optional: private-chat bots. Leave credentials empty to disable.
# HTTP/HTTPS origin reachable by phones and WeCom; domain or IP with optional port.
# Without a scheme, HTTP is used (for example 192.168.1.20:8765).
MELODOCK_PUBLIC_URL=
MELODOCK_LINK_TTL_SECONDS=86400
# Comma-separated enabled source IDs; empty uses the web settings.
MELODOCK_BOT_SOURCES=
# Telegram: numeric user IDs, NOT usernames. Only private chats are accepted.
MELODOCK_TG_TOKEN=
MELODOCK_TG_ALLOWED_USERS=
# Cloud API: 50 MB uploads. Self-hosted Bot API with --local: up to 2000 MB.
MELODOCK_TG_API_URL=https://api.telegram.org
# Optional built-in official Local Bot API (Docker image includes the binary).
# The Web settings are preferred; API ID and API Hash come from my.telegram.org.
MELODOCK_TG_LOCAL_ENABLED=0
MELODOCK_TG_LOCAL_API_ID=
MELODOCK_TG_LOCAL_API_HASH=
# Legacy independent proxy; prefer selecting the project proxy in Web settings.
MELODOCK_TG_PROXY=
# WeCom self-built application: callback URL is PUBLIC_URL + /bot/wecom.
MELODOCK_WECOM_CORP_ID=
MELODOCK_WECOM_AGENT_ID=
MELODOCK_WECOM_SECRET=
MELODOCK_WECOM_TOKEN=
MELODOCK_WECOM_AES_KEY=
MELODOCK_WECOM_ALLOWED_USERS=

# Optional download result notifications (enabled by nonempty webhook on first setup).
# Prefer Web settings for enabling/disabling channels and storing credentials.
MELODOCK_DISCORD_WEBHOOK=
MELODOCK_FEISHU_WEBHOOK=
MELODOCK_FEISHU_SIGN_SECRET=
MELODOCK_DINGTALK_WEBHOOK=
MELODOCK_DINGTALK_SIGN_SECRET=
